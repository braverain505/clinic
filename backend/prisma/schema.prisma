// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  fullName  String
  role      String     @default("ADMIN") // ADMIN, OPTOMETRIST, CASHIER
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  examinations EyeExamination[]
  prescriptions Prescription[]
  payments Payment[]
  stockMovements StockMovement[]
  auditLogs AuditLog[]
  spectacleOrders SpectacleOrder[]
  purchaseOrders PurchaseOrder[]
  expenses Expense[]
  staff       Staff?

  @@map("users")
}

model Patient {
  id        String     @id @default(cuid())
  patientId String     @unique @default(dbgenerated("concat('LIS-', LPAD(CAST(nextval('patient_seq') AS text), 6, '0'))"))
  firstName String
  lastName  String
  phone     String
  email     String?
  gender    String     // MALE, FEMALE, OTHER
  dateOfBirth DateTime?
  address   String?
  city      String?
  state      String?
  country    String?
  
  // Medical history
  medicalHistory String?
  ocularHistory  String?
  allergies      String?
  emergencyContact String?
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  examinations EyeExamination[]
  prescriptions Prescription[]
  opticalSales OpticalSale[]
  payments Payment[]
  followUps FollowUp[]
  spectacleOrders SpectacleOrder[]

  @@map("patients")
}

model EyeExamination {
  id        String     @id @default(cuid())
  examId    String     @unique @default(dbgenerated("concat('EXM-', LPAD(CAST(nextval('exam_seq') AS text), 6, '0'))"))
  
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  userId    String
  optometrist User     @relation(fields: [userId], references: [id])
  
  examinationDate DateTime @default(now())
  
  // Visual Acuity
  vaRightDistance   String?
  vaLeftDistance    String?
  vaBothDistance    String?
  vaRightNear       String?
  vaLeftNear        String?
  vaBothNear        String?
  
  // Refraction - Right Eye
  rhSphere    Float?
  rhCylinder  Float?
  rhAxis      Float?
  rhAdd       Float?
  rhPrism     Float?
  
  // Refraction - Left Eye
  lhSphere    Float?
  lhCylinder  Float?
  lhAxis      Float?
  lhAdd       Float?
  lhPrism     Float?
  
  // Additional measurements
  pupillaryDistance Float?
  nearPD Float?
  
  // Clinical tests
  tonometry String?
  colourVision String?
  keratometry String?
  visualFields String?
  otherTests String?
  
  // Clinical notes
  clinicalNotes String?
  diagnosis String?
  treatment String?
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  prescriptions Prescription[]
  followUps FollowUp[]

  @@map("eye_examinations")
}

model Prescription {
  id        String     @id @default(cuid())
  rxId      String     @unique @default(dbgenerated("concat('RX-', LPAD(CAST(nextval('prescription_seq') AS text), 6, '0'))"))
  
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  examinationId String
  examination   EyeExamination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  
  userId    String
  optometrist User     @relation(fields: [userId], references: [id])
  
  // Right Eye
  rhSphere    Float?
  rhCylinder  Float?
  rhAxis      Float?
  rhAdd       Float?
  rhPrism     Float?
  
  // Left Eye
  lhSphere    Float?
  lhCylinder  Float?
  lhAxis      Float?
  lhAdd       Float?
  lhPrism     Float?
  
  // PD
  pupillaryDistance Float?
  
  // Additional info
  recommendations String?
  reviewDate DateTime?
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  opticalSales OpticalSale[]
  spectacleOrders SpectacleOrder[]

  @@map("prescriptions")
}

model Product {
  id        String     @id @default(cuid())
  sku       String     @unique
  barcode   String?    @unique
  name      String
  category  String     // FRAMES, LENSES, CONTACT_LENSES, ACCESSORIES
  brand     String
  description String?
  
  purchasePrice Float
  sellingPrice Float
  quantity Int @default(0)
  minimumStock Int @default(10)
  
  supplier String?
  status   String @default("ACTIVE") // ACTIVE, INACTIVE, DISCONTINUED
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  saleItems OpticalSaleItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model StockMovement {
  id        String     @id @default(cuid())
  
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  previousQuantity Int
  quantityChanged Int
  newQuantity Int
  reason String // SALE, RETURN, ADJUSTMENT, PURCHASE
  
  userId String
  user User @relation(fields: [userId], references: [id])
  
  createdAt DateTime   @default(now())

  @@map("stock_movements")
}

model OpticalSale {
  id        String     @id @default(cuid())
  invoiceId String     @unique @default(dbgenerated("concat('INV-', LPAD(CAST(nextval('invoice_seq') AS text), 6, '0'))"))
  
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  
  subtotal Float
  discount Float @default(0)
  total Float
  
  paymentStatus String @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID
  amountPaid Float @default(0)
  outstandingBalance Float
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  items OpticalSaleItem[]
  payments Payment[]
  receipt Receipt?

  @@map("optical_sales")
}

model OpticalSaleItem {
  id        String     @id @default(cuid())
  
  saleId String
  sale   OpticalSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  quantity Int
  unitPrice Float
  total Float

  @@map("optical_sale_items")
}

model Payment {
  id        String     @id @default(cuid())
  
  saleId String
  sale   OpticalSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  amount Float
  paymentMethod String // CASH, BANK_TRANSFER, POS, CARD
  reference String?
  
  userId String
  receivedBy User @relation(fields: [userId], references: [id])
  
  paymentDate DateTime @default(now())
  createdAt DateTime   @default(now())

  @@map("payments")
}

model Receipt {
  id        String     @id @default(cuid())
  receiptNumber String @unique @default(dbgenerated("concat('RCP-', LPAD(CAST(nextval('receipt_seq') AS text), 6, '0'))"))
  
  saleId String @unique
  sale   OpticalSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  patientName String
  patientId String
  invoiceNumber String
  
  items String? // JSON stringified items
  subtotal Float
  discount Float
  grandTotal Float
  amountPaid Float
  balance Float
  paymentMethod String
  receivedBy String
  
  createdAt DateTime   @default(now())

  @@map("receipts")
}

model FollowUp {
  id        String     @id @default(cuid())
  
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  examinationId String?
  examination   EyeExamination? @relation(fields: [examinationId], references: [id], onDelete: SetNull)
  
  reason String
  followUpDate DateTime
  assignedStaff String?
  notes String?
  
  status String @default("PENDING") // PENDING, CONTACTED, SCHEDULED, COMPLETED, MISSED
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("follow_ups")
}

model Notification {
  id        String     @id @default(cuid())
  
  title String
  message String
  type String // PATIENT_REGISTERED, PAYMENT_RECEIVED, LOW_STOCK, FOLLOWUP_DUE, OUTSTANDING_PAYMENT, NEW_ORDER
  
  read Boolean @default(false)
  
  createdAt DateTime   @default(now())

  @@map("notifications")
}

model AuditLog {
  id        String     @id @default(cuid())
  
  userId String
  user User @relation(fields: [userId], references: [id])
  
  action String // created, updated, deleted
  entity String // Patient, Prescription, OpticalSale, etc.
  entityId String
  
  changes String? // JSON of what changed
  
  createdAt DateTime   @default(now())

  @@map("audit_logs")
}

// Sequences for generating IDs
model Sequence {
  id        String     @id @default(cuid())
  name      String     @unique
  value     BigInt     @default(1)

  @@map("sequences")
}

model Supplier {
  id        String     @id @default(cuid())
  supplierId String    @unique @default(dbgenerated("concat('SUP-', LPAD(CAST(nextval('supplier_seq') AS text), 6, '0'))"))
  company   String
  contactName String?
  phone     String
  email     String?
  address   String?
  paymentTerms String?
  balance   Float      @default(0)
  status    String     @default("ACTIVE")
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  purchaseOrders PurchaseOrder[]
  spectacleOrders SpectacleOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id        String     @id @default(cuid())
  poNumber  String     @unique @default(dbgenerated("concat('PO-', LPAD(CAST(nextval('po_seq') AS text), 6, '0'))"))
  supplierId String
  supplier  Supplier   @relation(fields: [supplierId], references: [id])
  userId    String
  createdBy User      @relation(fields: [userId], references: [id])
  total     Float      @default(0)
  status    String     @default("DRAFT") // DRAFT, SUBMITTED, CONFIRMED, RECEIVED, CANCELLED
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id        String     @id @default(cuid())
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId String?
  productName String
  quantity  Int
  unitPrice Float
  total     Float
  received  Int        @default(0)

  @@map("purchase_order_items")
}

model Expense {
  id        String     @id @default(cuid())
  expenseId String     @unique @default(dbgenerated("concat('EXP-', LPAD(CAST(nextval('expense_seq') AS text), 6, '0'))"))
  category  String     // RENT, UTILITIES, SALARIES, TRANSPORTATION, PROCUREMENT, MAINTENANCE, MARKETING, SUPPLIES, OTHER
  description String
  amount    Float
  date      DateTime   @default(now())
  paymentMethod String?
  reference String?
  status    String     @default("APPROVED") // SUBMITTED, APPROVED, REJECTED, PAID
  userId    String
  createdBy User      @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("expenses")
}

model Staff {
  id        String     @id @default(cuid())
  employeeId String    @unique @default(dbgenerated("concat('EMP-', LPAD(CAST(nextval('staff_seq') AS text), 6, '0'))"))
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  phone     String?
  department String?
  position  String?
  employmentDate DateTime?
  status    String     @default("ACTIVE") // ACTIVE, INACTIVE, TERMINATED
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  attendance Attendance[]

  @@map("staff")
}

model SpectacleOrder {
  id        String     @id @default(cuid())
  orderNumber String   @unique @default(dbgenerated("concat('SPE-', LPAD(CAST(nextval('spec_order_seq') AS text), 6, '0'))"))
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionId String?
  prescription  Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  frameProduct String?
  lensProduct  String?
  pd           Float?
  rightFittingHeight Float?
  leftFittingHeight  Float?
  segmentHeight Float?
  notes        String?
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cost         Float?
  sellingPrice Float?
  expectedCompletion DateTime?
  status       String     @default("DRAFT") // DRAFT, ORDERED, IN_PRODUCTION, READY, COLLECTED, CANCELLED
  userId       String
  createdBy    User      @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("spectacle_orders")
}

model Attendance {
  id        String     @id @default(cuid())
  staffId   String
  staff     Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime   @default(now())
  clockIn   DateTime?
  clockOut  DateTime?
  status    String     @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY, ON_LEAVE
  notes     String?
  createdAt DateTime   @default(now())

  @@map("attendance")
}
